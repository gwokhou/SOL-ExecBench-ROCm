  "reference": "import torch\n\ndef run(cache, update, slots):\n    shape = cache.shape\n    flat = cache.float().reshape(-1, shape[-2], shape[-1]).clone()\n    u = update.float().reshape(-1, shape[-2], shape[-1])\n    u = u.roll(1, dims=-1)\n    index = slots.reshape(-1).remainder(flat.shape[0]).long()\n    flat.index_copy_(0, index, u)\n    return flat.reshape(shape).to(torch.bfloat16)\n",
