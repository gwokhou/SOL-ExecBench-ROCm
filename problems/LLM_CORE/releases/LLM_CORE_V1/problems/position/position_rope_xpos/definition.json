  "reference": "import torch\n\ndef run(x, cos, sin):\n    x = x.float()\n    rotated = torch.stack((-x[..., 1::2], x[..., ::2]), dim=-1).flatten(-2)\n    c = cos.float()[None, None]\n    s = sin.float()[None, None]\n    return (x * c + rotated * s * 1.01).to(torch.bfloat16)\n",
