{
  "schema_version": "sol_execbench.definition.v1",
  "name": "diagnostic_composite_graph_f32",
  "op_type": "composite_graph",
  "description": "Single-stream acyclic elementwise-to-reduction FP32 graph.",
  "axes": {
    "M": {
      "type": "var",
      "description": "Governed M extent."
    },
    "N": {
      "type": "var",
      "description": "Governed N extent."
    }
  },
  "inputs": {
    "input": {
      "shape": [
        "M",
        "N"
      ],
      "dtype": "float32"
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "M"
      ],
      "dtype": "float32"
    }
  },
  "reference": "import torch\n\n\ndef run(input):\n    activated = torch.sigmoid(input)\n    return activated.sum(dim=-1)\n"
}
